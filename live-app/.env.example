# Copy this file to .env in this same folder (live-app/.env) and fill in your key.
# .env is already in .gitignore — it will never be committed.

# Get a free Gemini API key at https://aistudio.google.com/app/apikey
# (Google account -> "Create API key" -> copy it here)
GEMINI_API_KEY=

# Optional: which Gemini model to use. Defaults to a free-tier model if left blank.
GEMINI_MODEL=gemini-2.0-flash

# Port the local server listens on.
PORT=4000
